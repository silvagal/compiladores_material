\mode<presentation>

% Require Packages:
\RequirePackage{color}
\RequirePackage{xcolor}
\RequirePackage{graphics, graphicx,times}
\RequirePackage{amsmath,amssymb, amsthm, amsfonts}
\RequirePackage{array,multirow}
%\RequirePackage{arydshln}
\RequirePackage{textcomp}
\RequirePackage{tikz,tkz-euclide}
\RequirePackage{ listings}
\RequirePackage{calc}
\RequirePackage{multicol}
\RequirePackage[normalem]{ulem}
\RequirePackage{multimedia}
\RequirePackage{hyperref}
\RequirePackage{caption}
\RequirePackage{cancel}
\RequirePackage{empheq}

%new commands
\newcommand{\email}[1]{\\\mbox{}\\[-6pt]\footnotesize\texttt{#1}}
\newcommand{\site}[1]{\\\mbox{}\\[-6pt]\footnotesize\texttt{#1}}

% Box - Equação
\definecolor{formulabox}{rgb}{.8, .8, 1}
\definecolor{corquadro}{RGB}{176,196,222}

% String used between the current page and the total page count.
\def\beamer@decom@pageofpages{/}
\DeclareOptionBeamer{pageofpages}{\def\beamer@decom@pageofpages{#1}}

% Show a line below the frame title.
\DeclareOptionBeamer{titleline}[true]{\def\beamer@decom@titleline{#1}}

% Image used for the watermark.
\def\beamer@decom@watermarkorig{}
\DeclareOptionBeamer{watermark}{\def\beamer@decom@watermarkorig{#1}}

% Height of the watermark.
\def\beamer@decom@watermarkheight{100px}
\DeclareOptionBeamer{watermarkheight}{\def\beamer@decom@watermarkheight{#1}}

% The original image height is watermarkheightmult * watermarkheight.
\def\beamer@decom@watermarkheightmult{1}
\DeclareOptionBeamer{watermarkheightmult}{\def\beamer@decom@watermarkheightmult{#1}}

\ExecuteOptionsBeamer{titleline=true}
\ProcessOptionsBeamer

% Enable/disable the watermark.
\def\watermarkon{%
  \def\beamer@decom@watermark{\beamer@decom@watermarkorig}%
}
\def\watermarkoff{\def\beamer@decom@watermark{}}

% Initially enable the watermark.
\watermarkon

% Colors.
\setbeamercolor*{lineup}{use=structure,bg=structure.fg}
\setbeamercolor*{linemid}{parent=palette secondary}
\setbeamercolor*{linebottom}{parent=palette tertiary}
\setbeamercolor*{page header}{parent=titlelike}

% Lengths
\newlength{\headerheight}
\setlength{\headerheight}{.045\paperheight}
\newlength{\beamer@decolines@lineup}
\setlength{\beamer@decom@lineup}{.025\paperheight}
\newlength{\beamer@decolines@linemid}
\setlength{\beamer@decom@linemid}{.015\paperheight}
\newlength{\beamer@decolines@linebottom}
\setlength{\beamer@decom@linebottom}{.01\paperheight}

% The height of the watermark part below the 3 bottom lines.
\newlength{\beamer@decom@watermarkheightbottom}
\addtolength{\beamer@decom@watermarkheightbottom}{\beamer@decom@lineup}
\addtolength{\beamer@decom@watermarkheightbottom}{\beamer@decom@linemid}
\addtolength{\beamer@decom@watermarkheightbottom}{\beamer@decom@linebottom}

% The height of the watermark part over the 3 bottom lines before shrinking.
\newlength{\beamer@decom@watermarkheightupperorig}
\setlength{\beamer@decom@watermarkheightupperorig}{\beamer@decom@watermarkheight}
\addtolength{\beamer@decom@watermarkheightupperorig}{-\beamer@decom@watermarkheightbottom}
\multiply\beamer@decom@watermarkheightupperorig by \beamer@decom@watermarkheightmult

% Footer.
\defbeamertemplate*{footline}{decom theme}
{
  \leavevmode%
  \hbox{%
  } %
  \hbox{%
  } %
  \hbox{%
  } %
  \hbox{%
  }%
  \vskip1.5px%
  \if\beamer@decom@watermark\@empty\else%
    \vskip-\beamer@decom@watermarkheightbottom%
    \llap{\includegraphics[height=\beamer@decom@watermarkheightbottom,clip=true,%
      trim=0pt 0pt 0pt \beamer@decom@watermarkheightupperorig]{\beamer@decom@watermark}\hskip-\paperwidth}%
  \fi%
}

\defbeamertemplate*{headline}{decom theme}
{
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=\textwidth,ht=\headerheight,dp=0pt]{page header}%
  \end{beamercolorbox}%
  } %
  \vskip0pt%
}

\defbeamertemplate*{frametitle}{decom theme}[1][left]
{
  \ifbeamercolorempty[bg]{frametitle}{}{\nointerlineskip}%
  \@tempdima=\textwidth%
  \advance\@tempdima by\beamer@leftmargin%
  \advance\@tempdima by\beamer@rightmargin%
  \vbox{}\vskip-.9\beamer@leftmargin%
  \begin{beamercolorbox}[sep=\beamer@leftmargin,#1,wd=\the\@tempdima]{}
    \usebeamerfont{frametitle}\usebeamercolor[bg]{framesubtitle}%
    \vbox{}\vskip0ex%
    \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
    \strut{\large \insertframetitle}\strut\par%
    {%
      \ifx\insertframesubtitle\@empty%
      \else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[bg]{framesubtitle}\insertframesubtitle\strut\par}%
      \fi
    }%
    \vskip-1ex%
    \if@tempswa\else\vskip-\beamer@leftmargin\fi
  \end{beamercolorbox}%
  \def\beamer@decom@truetext{true}%
  \ifx\beamer@decom@titleline\beamer@decom@truetext%
    \vskip 0.5ex%
    \ifdim\textwidth<0.7\paperwidth
      \begin{beamercolorbox}[wd=\paperwidth,ht=.15ex,dp=0ex]{lineup}%
      \end{beamercolorbox}%
    \else
      \begin{beamercolorbox}[wd=\textwidth,ht=.15ex,dp=0ex]{lineup}%
      \end{beamercolorbox}%
    \fi
  \fi
}

% Frame title continuations, default
\defbeamertemplate*{frametitle continuation}{decom theme}{(\insertcontinuationcount)}

\defbeamertemplate*{sidebar right}{decom theme}
{
  \vskip.1\beamer@leftmargin%
  \llap{\insertlogo\hskip.2\beamer@leftmargin}%
  \vfill%
  \if\beamer@decom@watermark\@empty\else%
  \llap{\includegraphics[height=\beamer@decom@watermarkheight]{\beamer@decom@watermark}}%
  \vskip-\beamer@decom@watermarkheightbottom%
  \fi
}

\mode
<all>